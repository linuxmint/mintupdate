#!/usr/bin/python3
import os
import sys

if __name__ == "__main__":
    if os.getuid() == 0:
        try:
            import apt
            cache = apt.Cache()
            cache.update()
        except Exception as e:
            print("Error: mint-refresh-cache could not update the cache.")
            print(e)
            sys.exit(1)
    else:
        print("Error: mint-refresh-cache requires admin privileges")
        sys.exit(1)
