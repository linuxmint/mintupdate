msgstr ""
"Wpisz nazwę pakietu aktualizacji do zignorowania (znaki specjalne są "
"wspierane) i opcjonalnie wersję:"

#: usr/lib/linuxmint/mintUpdate/preferences.py:252
msgid "Ignore an Update"
msgstr "Ignoruj aktualizację"

