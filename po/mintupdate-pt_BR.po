msgstr "As seguintes Spices foram atualizadas automaticamente:"

#: usr/lib/linuxmint/mintUpdate/session_automatic_upgrades.py:57
msgid "Cinnamon was restarted"
msgstr "O Cinnamon foi reiniciado"

