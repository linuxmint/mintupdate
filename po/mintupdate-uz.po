msgstr ""
"E'tibor bermaslik uchun yangilanishning manba paketi nomini "
"(almashtiriluvchi belgilar qo‘llab-quvvatlanadi) va ixtiyoriy ravishda "
"versiyasini belgilang:"

#: usr/lib/linuxmint/mintUpdate/preferences.py:252
msgid "Ignore an Update"
msgstr "Yangilanishga e'tibor berilmasin"

#: usr/lib/linuxmint/mintUpdate/preferences.py:260
