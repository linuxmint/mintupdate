msgstr "Cliciwch ar y ddolen i bori'r nodweddion newydd."

#: usr/lib/linuxmint/mintUpdate/rel_upgrade.py:138
msgid "Requirements"
msgstr "Anghenion"

#: usr/lib/linuxmint/mintUpdate/rel_upgrade.py:147
#, python-format
